void getWeatherData() { 
  WiFiClient client; 
 
  Serial.println("Requesting  URL: " + endpoint); 
 
  if (client.connect("api.openweathermap.org",  80)) { 
    Serial.println("Connected  to OpenWeatherMap API"); 
 
    client.println("GET  " + endpoint + " HTTP/1.1"); 
    client.println("Host:  api.openweathermap.org");  
    client.println("Connection:  close"); 
    client.println();  
 
    while (client.connected()  &&!client.available())  { 
      delay(100); 
    } 
 
    // 跳过HTTP头 
    String response = ""; 
    while (client.available())  { 
      String line = client.readStringUntil('\n');  
      if (line == "\r") { // HTTP头结束的标志 
        break; 
      } 
    } 
 
    // 读取JSON数据 
    while (client.available())  { 
      char c = client.read();  
      response += c; 
    } 
 
    client.stop();  
 
    Serial.println("API  Response: " + response); 
 
    DynamicJsonDocument doc(2048); // 增加缓冲区大小 
    DeserializationError error = deserializeJson(doc, response); 
 
    if (error) { 
      Serial.print("JSON  parsing failed: "); 
      Serial.println(error.c_str());  
      return; 
    } 
 
    cityName = doc["name"].as<String>(); 
    weatherDescription = doc["weather"][0]["main"].as<String>(); 
    temperature = doc["main"]["temp"].as<float>(); 
    humidity = doc["main"]["humidity"].as<float>(); 
    pressure = doc["main"]["pressure"].as<float>(); 
    speed    = doc["wind"]["speed"].as<float>();
 
    Serial.println("......");  
    Serial.println("simon's  weather report"); 
    Serial.println("City:  " + cityName); 
    Serial.println("Weather  main: " + weatherDescription); 
    Serial.println("Temperature:  " + String(temperature) + " C"); 
    Serial.println("Humidity:  " + String(humidity) + " %"); 
    Serial.println("Pressure:  " + String(pressure) + " hPa"); 
    Serial.println("Wind    :  " + String(speed) + " m/s"); 
 
  } else { 
    Serial.println("Connection  to OpenWeatherMap API failed"); 
  } 
} 

/**
 * 从股票数据中提取指定索引的参数
 * @param rawData 原始数据字符串，格式如：v_sh600460="1~士兰微~600460~26.74..."
 * @param index   要提取的参数索引（从0开始）
 * @return        对应的参数值，若不存在返回空字符串
 */
String getStockParameter(const String &rawData, int index) {
    // 提取引号内的有效数据
    int quoteStart = rawData.indexOf('\"');
    int quoteEnd = rawData.lastIndexOf('\"');
    if (quoteStart == -1 || quoteEnd == -1 || quoteStart >= quoteEnd) {
        return "";
    }
    String data = rawData.substring(quoteStart + 1, quoteEnd);

    // 遍历查找目标索引
    int currentIndex = 0;
    int startPos = 0;
    int endPos = data.indexOf('~');

    while (currentIndex < index && endPos != -1) {
        startPos = endPos + 1;
        endPos = data.indexOf('~', startPos);
        currentIndex++;
    }

    // 返回结果处理
    if (currentIndex != index) return "";
    return (endPos == -1) ? 
           data.substring(startPos) : 
           data.substring(startPos, endPos);
}

void UPDATE_Time(void)
{
    // 更新 NTP 时间
  timeClient.update();

  // 获取当前时间戳
  time_t epochTime = timeClient.getEpochTime();  // 使用 time_t 类型
  struct tm *ptime = gmtime(&epochTime);         // 修复错误

  year = ptime->tm_year + 1900;
  month = ptime->tm_mon + 1;
  day = ptime->tm_mday;
  hour = ptime->tm_hour;
  minute = ptime->tm_min;
  second = ptime->tm_sec;
  weekday = ptime->tm_wday;  // 0 = Sunday, 1 = Monday, ..., 6 = Saturday

  // 打印当前时间
  Serial.printf("Current Time: %04d-%02d-%02d %02d:%02d:%02d\n", year, month, day, hour, minute, second);

  // 判断是否是工作日（周一到周五）
  isWeekday = (weekday >= 1 && weekday <= 5);

  // 判断是否是上班时间（9:00 - 15:00）
  isWorkingTime = (hour >= 9 && hour < 15);

  // 输出判断结果
  Serial.print("Is it a weekday? ");
  Serial.println(isWeekday ? "Yes" : "No");

  Serial.print("Is it working time? ");
  Serial.println(isWorkingTime ? "Yes" : "No");
}

